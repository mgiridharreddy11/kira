{
  "expo": {
    "name": "Kairo Chat",
    "slug": "kairo-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kairochat",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kairochat.app"
    },
    "android": {
      "package": "com.kairochat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B0E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kairo Chat to access your camera to capture snaps and stories.",
          "microphonePermission": "Allow Kairo Chat to access your microphone to record audio in snaps and video messages."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kairo Chat to use biometrics to unlock your Private Vault."
        }
      ],
      [
        "expo-secure-store"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
